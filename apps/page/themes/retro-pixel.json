{
  "label": "Retro pixel",
  "description": "The original recommend-me look: pixel fonts, hard shadows, square corners.",
  "extends": "base",
  "tokens": {
    "color.bg": "#f9fafb",
    "color.surface": "#ffffff",
    "color.text": "#2a2a2a",
    "color.muted": "#4a4a4a",
    "color.border": "#2a2a2a",
    "color.accent": "#059669",
    "color.rating": "#d97706",
    "font.heading": "Press Start 2P",
    "font.body": "Pixelify Sans",
    "radius": 0,
    "border.width": 3,
    "shadow": "hard",
    "layout": "grid"
  },
  "css": [
    "[data-ryt=\"hero\"] h1 { font-size: clamp(1.1rem, 4vw, 1.8rem); line-height: 1.5; }",
    "[data-ryt=\"section\"] > h2 { font-size: .8rem; text-transform: uppercase; }",
    "[data-ryt=\"rating\"] b { font-size: .9rem; }"
  ]
}
